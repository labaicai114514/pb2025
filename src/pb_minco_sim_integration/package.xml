<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pb_minco_sim_integration</name>
  <version>0.1.0</version>
  <description>Simulation-only integration launch and parameters for the vendored ROGMap and MINCO stack.</description>
  <maintainer email="labaicai@example.com">RM simulation maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pb2025_nav_bringup</exec_depend>
  <exec_depend>ros_interfaces</exec_depend>
  <exec_depend>rog_map</exec_depend>
  <exec_depend>minco_planner</exec_depend>
  <exec_depend>minco_controller</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
